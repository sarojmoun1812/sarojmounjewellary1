# Copy this file to .env and fill in real values.
#
# Keep everything in a single .env. Do not add a .env.local — two files setting
# the same variable to different values previously broke the build and locked
# the admin out of the panel.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local development with SQLite:
#   DATABASE_URL="file:./dev.db"
# Production (Render Postgres) — use the External Connection String:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
#
# prisma/schema.prisma must declare the matching provider.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Admin password hashes are derived from this value, so changing it invalidates
# every existing password. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Optional. While set (16+ chars), the login page can create the first admin.
# Remove it once the admin account exists. The normal way to create or reset an
# admin is: ADMIN_EMAIL=... ADMIN_PASSWORD=... node scripts/create-admin.js
ADMIN_SETUP_TOKEN=""

# ---------------------------------------------------------------------------
# Silver rate feed
# ---------------------------------------------------------------------------
# https://metalpriceapi.com/ — without it, the rate is whatever was last saved
# in the admin panel. Every product price derives from this, so keep it current.
#
# The feed reports the international spot price. The premium that turns it into
# her real buying rate is a setting in the admin panel, not an env var.
METAL_PRICE_API_KEY=""

# Guards /api/cron/silver-rate, the daily refresh Vercel calls. Without it the
# endpoint is open and anyone can burn through the metal price API quota.
# Any long random string; Vercel sends it as "Authorization: Bearer <value>".
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Photo uploads (required before she can add products)
# ---------------------------------------------------------------------------
# Preferred: connect a Blob store to the Vercel project. The token below then
# appears in the environment on its own, and no keys have to be copied by hand.
BLOB_READ_WRITE_TOKEN=""

# Only needed if Cloudinary is used instead of Vercel Blob.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# The public origin, with no trailing slash. Canonical URLs, the sitemap,
# robots.txt and every share preview are built from it, so in production this
# must be the real domain — a stale value here is invisible until a customer
# taps a shared link and lands nowhere.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Saroj Moun Jewellery"

# Optional. Paste the verification token from Google Search Console so Google
# can confirm you own the domain. Used in app/layout.tsx metadata.verification.
GOOGLE_SITE_VERIFICATION=""

# Digits only, including the country code. Customer orders are sent here.
NEXT_PUBLIC_WHATSAPP_NUMBER="918168790171"
